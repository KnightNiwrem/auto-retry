{
    "name": "@grammyjs/auto-retry",
    "version": "3.0.0-beta.0",
    "exports": "./src/mod.ts",
    "imports": {
        "@grammyjs/debug": "jsr:@grammyjs/debug@^0.3.1",
        "@grammyjs/grammy": "jsr:@grammyjs/grammy@^2.0.0-beta.7",
        "@std/assert": "jsr:@std/assert@^1.0.16"
    },
    "license": "MIT",
    "publish": {
        "include": [
            "LICENSE",
            "README.md",
            "src/**/*.ts"
        ]
    },
    "nodeModulesDir": "none",
    "lock": false,
    "tasks": {
        "ok": "deno fmt --check && deno lint && deno check && deno test",
        "publish:jsr": "deno publish",
        "publish:jsr:dry-run": "deno publish --dry-run"
    },
    "fmt": {
        "proseWrap": "preserve",
        "indentWidth": 4
    },
    "lint": {
        "rules": {
            "include": ["no-top-level-await"]
        }
    }
}
